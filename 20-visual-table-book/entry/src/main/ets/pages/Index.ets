interface Table { id:string; seats:number; available:boolean; }
const TABLES: Table[]=[{id:'A1',seats:2,available:true},{id:'A2',seats:2,available:false},{id:'B1',seats:4,available:true},{id:'B2',seats:4,available:true}];
@Entry @Component struct Index { @State private selected:string=''; @State private people:number=2; @State private drafted:boolean=false;
  private table():Table|undefined { for(let i=0;i<TABLES.length;i+=1) if(TABLES[i].id===this.selected)return TABLES[i]; return undefined; }
  build(){ Scroll(){Column({space:16}){
    Text('可视化订桌').fontSize(30).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_primary'))
    Text('演示模式：不连接真实餐厅、库存或支付。').fontSize(17).fontColor($r('app.color.text_secondary'))
    Column({space:6}){Text('任何草稿都不会发送给商家，也不是确认预约。').fontSize(16).fontWeight(FontWeight.Medium).fontColor($r('app.color.text_notice'));Text('日期为演示日期，桌位状态仅用于练习选择。').fontSize(14).fontColor($r('app.color.text_notice'))}.padding(16).backgroundColor($r('app.color.notice')).borderRadius(18).width('100%')
    Column({space:8}){Text('演示人数').fontSize(20).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_primary'));Row({space:12}){Button('2 人').backgroundColor(this.people===2?$r('app.color.active'):$r('app.color.card')).fontColor($r('app.color.text_primary')).onClick(()=>{this.people=2;this.drafted=false});Button('4 人').backgroundColor(this.people===4?$r('app.color.active'):$r('app.color.card')).fontColor($r('app.color.text_primary')).onClick(()=>{this.people=4;this.drafted=false})}}.padding(20).backgroundColor($r('app.color.card')).borderRadius(20).width('100%')
    Column({space:10}){Text('选择演示桌位').fontSize(20).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_primary'));ForEach(TABLES,(item:Table)=>{Button(`${item.id} · ${item.seats} 座 · ${item.available?'可选演示桌':'不可用演示桌'}`).width('100%').padding(15).borderRadius(15).backgroundColor(this.selected===item.id?$r('app.color.active'):$r('app.color.card')).fontColor($r('app.color.text_primary')).enabled(item.available&&item.seats>=this.people).onClick(()=>{this.selected=item.id;this.drafted=false})},(item:Table)=>item.id)}.padding(20).backgroundColor($r('app.color.card')).borderRadius(20).width('100%')
    Button('创建本地预约草稿').width('100%').height(54).backgroundColor($r('app.color.action')).fontColor($r('app.color.on_action')).borderRadius(15).enabled(this.table()!==undefined).onClick(()=>this.drafted=true)
    if(this.drafted){Column({space:8}){Text('本地草稿已创建').fontSize(20).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_success'));Text(`${this.selected} · ${this.people} 人 · 演示日期。未发送给商家，未占用真实桌位。`).fontSize(16).fontColor($r('app.color.text_primary'));Button('取消本地草稿').fontColor($r('app.color.action')).backgroundColor(Color.Transparent).onClick(()=>this.drafted=false)}.padding(20).backgroundColor($r('app.color.active')).borderRadius(20).width('100%')}
  }.padding({left:20,right:20,top:28,bottom:36}).alignItems(HorizontalAlign.Start).width('100%')}.width('100%').height('100%').backgroundColor($r('app.color.canvas'))}}
