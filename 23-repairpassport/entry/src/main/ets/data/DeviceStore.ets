import { preferences } from '@kit.ArkData';
export interface RepairEvent { id: number; eventType: string; eventDate: string; note: string; }
export interface DeviceCard { id: number; category: string; model: string; purchaseDate: string; warrantyDate: string; events?: RepairEvent[]; }
export class DeviceStore { async load(context: Context): Promise<DeviceCard[]> { const store = await preferences.getPreferences(context, 'mendbook-devices'); const value = await store.get('cards', '') as string; try { const cards = value.length > 0 ? JSON.parse(value) as DeviceCard[] : []; return cards.map((card: DeviceCard) => ({ id: card.id, category: card.category, model: card.model, purchaseDate: card.purchaseDate, warrantyDate: card.warrantyDate, events: card.events ?? [] } as DeviceCard)); } catch { return []; } } async save(context: Context, cards: DeviceCard[]): Promise<void> { const store = await preferences.getPreferences(context, 'mendbook-devices'); await store.put('cards', JSON.stringify(cards)); await store.flush(); } }
