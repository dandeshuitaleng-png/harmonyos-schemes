const FEELINGS:string[]=['我需要被倾听','我想暂时安静','我希望得到具体帮助'];
@Entry @Component struct Index { @State private selected:string=''; @State private card:string='';
 build(){Scroll(){Column({space:16}){Text('共情回声').fontSize(30).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_primary'));Text('本地沟通卡 · 不登录、不上传、不建社区').fontSize(16).fontColor($r('app.color.text_secondary'));Column({space:8}){Text('选择此刻想表达的需求').fontSize(20).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_primary'));ForEach(FEELINGS,(item:string)=>{Button(item).width('100%').padding(15).fontColor($r('app.color.text_primary')).backgroundColor(this.selected===item?$r('app.color.active'):$r('app.color.card')).borderRadius(15).onClick(()=>{this.selected=item;this.card=''})},(item:string)=>item)}.padding(20).backgroundColor($r('app.color.card')).borderRadius(20).width('100%');Button('创建本地沟通卡').width('100%').height(54).fontColor($r('app.color.on_action')).backgroundColor($r('app.color.action')).borderRadius(15).enabled(this.selected!=='').onClick(()=>this.card=this.selected);if(this.card!==''){Column({space:8}){Text('本地预览').fontSize(20).fontWeight(FontWeight.Bold).fontColor($r('app.color.text_primary'));Text(`我想说：${this.card}。`).fontSize(17).fontColor($r('app.color.text_primary'));Text('这张卡只存在于当前会话；尚未通过系统渠道分享。').fontSize(14).fontColor($r('app.color.text_secondary'));Button('删除本地卡').fontColor($r('app.color.action')).backgroundColor(Color.Transparent).onClick(()=>this.card='')}.padding(20).backgroundColor($r('app.color.active')).borderRadius(20).width('100%')}}.padding(20).alignItems(HorizontalAlign.Start).width('100%')}.width('100%').height('100%').backgroundColor($r('app.color.canvas'))}}
